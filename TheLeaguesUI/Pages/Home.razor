@inject ILeagueService leagueService

@page "/"
@using TheLeaguesUI.Services.Interfaces

<PageTitle>theLeagues</PageTitle>

<div class="container-fluid">
    <h1>The Leagues</h1>
    <div class="league-icons">
        @{
            foreach(var league in leagues)
            {
                <div class="league-icon">
                    <img src="@league.Logo" alt="@league.Name"/>
                </div>
            }
        }

    </div>
</div>

@code{

    private List<LeagueDTO> leagues = new();
    protected override async Task OnInitializedAsync()
        {
            var getAllLeaguesOperationalResult = await leagueService.GetAllLeagues();
            leagues = getAllLeaguesOperationalResult.Data ?? new();;
        }
}
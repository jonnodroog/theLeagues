@inject ILeagueService leagueService
@inject ITeamService teamService

@page "/"
@using TheLeaguesUI.Pages.Components
@using TheLeaguesUI.Services.Interfaces

<PageTitle>theLeagues</PageTitle>
<div class="content">
    <div class="league-cards">
        @{
            foreach (var league in _leagues)
            {
                <div @onmouseover="() => HandleLeagueCardClick(league)" @onclick="() => HandleLeagueCardClick(league)">
                    <LeagueCard League="league" />
                </div>
            }
        }
    </div>
    <div class="log-panel">
        @if (SelectedLeague.Teams.Count > 0)
        {
            <LogPanel CurrentLeague="@SelectedLeague" />
        }
        else if (SelectedLeague is null)
        {
            <p>Select a league from the list on the left</p>
        }
        else
        {
            <p>Whoops. No data to display for @SelectedLeague.Name (sorry)</p>
        }
    </div>
</div>

@code {

    private List<LeagueDTO> _leagues = new();
    private List<TeamDTO> _teams = new();
    private LeagueDTO SelectedLeague = new();
    protected override async Task OnInitializedAsync()
    {
        var getAllLeaguesOperationalResult = await leagueService.GetAllLeagues();
        _leagues = getAllLeaguesOperationalResult.Data ?? new(); ;
        SelectedLeague = _leagues.First();

        foreach (var league in _leagues)
        {
            var getAllTeamsInLeagueOperationalResult = await teamService.GetAllTeamsInLeague(league.Id);
            var teamsRetrieved = getAllTeamsInLeagueOperationalResult.Data;
            
            if (teamsRetrieved is not null && teamsRetrieved.Count() > 0)
            {
                foreach (var team in teamsRetrieved)
                {
                    _teams.Add(team);
                }
                
                //Sorting teams the less performant way
                //league.Teams = teamsRetrieved;
                //league.Teams.Sort((x,y) => x.CurrentLeagueRank.CompareTo(y.CurrentLeagueRank));

                //Sorting teams the more performant way
                league.Teams = teamsRetrieved.OrderBy(x => x.CurrentLeagueRank).ThenByDescending(y => y.GoalsDiff).ThenByDescending(z => z.GoalsFor).ToList();
            }
        }
    }

    private void HandleLeagueCardClick(LeagueDTO league)
    {
        SelectedLeague = league;
    }
}
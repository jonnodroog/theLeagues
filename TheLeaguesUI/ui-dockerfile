# 1. BUILD STAGE
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# 2. Copy all files to docker container
COPY . .

# 3. Set the working directory i.e. where we are going to execute the publish
WORKDIR "/src/TheLeaguesUI"

# 4. Execute the publish
RUN dotnet publish "TheLeaguesUI.csproj" -c Release -o /app/publish /p:UseAppHost=false

# 5. SERVER STAGE (Nginx)
FROM nginx:alpine
WORKDIR /usr/share/nginx/html

# Copy the compiled static files from the build stage
COPY --from=build /app/publish/wwwroot .
# Copy a custom nginx config 
COPY TheLeaguesUI/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80

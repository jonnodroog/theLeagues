# 1. BUILD STAGE
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["TheLeaguesUI/TheLeaguesUI.csproj", "TheLeaguesUI/"]
COPY ["Models/Models.csproj", "Models/"]

RUN dotnet restore "TheLeaguesUI/TheLeaguesUI.csproj"

COPY . .
WORKDIR "/src/TheLeaguesUI"
RUN dotnet publish -c Release -o /app/publish

# 2. SERVER STAGE (Nginx)
FROM nginx:alpine
WORKDIR /usr/share/nginx/html
# Copy the compiled static files from the build stage
COPY --from=build /app/publish/wwwroot .
# Copy a custom nginx config 
COPY TheLeaguesUI/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
